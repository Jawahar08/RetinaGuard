# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
LOG_LEVEL=INFO

# CORS Settings (comma separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ML Inference Configuration
MODEL_DIR=artifacts/checkpoints
CONFIG_DIR=configs
DEVICE=cpu

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_MOCK=false

# Clinical Records Database Configuration
# Primary: Supabase (Cloud PostgreSQL) - Optional (leave blank to run in Local SQLite Mode)
SUPABASE_URL=
SUPABASE_KEY=

# Local Backup Database (SQLite)
SQLITE_DB_PATH=data/retinaguard.db
